{
  "name": "taskify-rsvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:rules && firebase emulators:exec --only auth,database \"npm run test:e2e\"",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only auth,database \"vitest run tests/rules --fileParallelism=false\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "qrcode": "1.5.4",
    "read-excel-file": "^9.3.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.32.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
